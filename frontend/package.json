{
  "name": "bekal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:icons": "tauri icon --output src-tauri/generated-icons src-tauri/branding/bekal-icon.svg",
    "desktop:runtime": "node scripts/prepare-desktop-runtime.mjs",
    "desktop:prepare": "npm run desktop:icons && npm run desktop:runtime",
    "tauri": "npm run desktop:prepare && tauri"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
