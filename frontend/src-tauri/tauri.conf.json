{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BEKAL",
  "mainBinaryName": "BEKAL",
  "version": "0.2.0",
  "identifier": "com.haziqzes.bekal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BEKAL",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Wan Haziq",
    "copyright": "Copyright © 2026 Wan Haziq",
    "category": "Utility",
    "shortDescription": "Local-first grocery receipt intelligence.",
    "longDescription": "BEKAL turns grocery receipt PDFs into structured, editable spending records while keeping household data local.",
    "homepage": "https://github.com/haziqzes/Project-BEKAL",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "resources": [
      "generated-runtime"
    ],
    "icon": [
      "generated-icons/32x32.png",
      "generated-icons/128x128.png",
      "generated-icons/128x128@2x.png",
      "generated-icons/icon.icns",
      "generated-icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "BEKAL",
        "installerIcon": "generated-icons/icon.ico",
        "uninstallerIcon": "generated-icons/icon.ico"
      }
    }
  }
}
